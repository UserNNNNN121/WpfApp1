<Window x:Class="WpfApp1.Course"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enterprice Courses" Height="800" Width="1200" Icon="/logo2.png">
    <Window.Resources>
        <Style x:Key="BottomButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" 
                                            RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="DarkGray"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="Gray"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="LightGray"/>
                                <Setter Property="Foreground" Value="DarkGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3366CC"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,10,0,0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="458*"/>
                <ColumnDefinition Width="375*"/>
                <ColumnDefinition Width="83*"/>
                <ColumnDefinition Width="458*"/>
                <ColumnDefinition Width="458*"/>
            </Grid.ColumnDefinitions>

            <Image Source="/logo.png"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Height="51"
                   Width="76"
                   Grid.Column="0"
                   Margin="14,4,0,0"
                   Cursor="Hand"
                   MouseLeftButtonDown="btnMain_Click"/>

            <Button x:Name="btnFAQs" Content="FAQs"
                    Style="{StaticResource BottomButtonStyle}"
                    Grid.Column="1" Margin="5,0,6,0" Click="btnFAQs_Click"/>

            <Button x:Name="btnMain" Content="Главная"
                    Style="{StaticResource BottomButtonStyle}"
                    Grid.Column="2" Margin="4,0,5,0" Click="btnMain_Click" Grid.ColumnSpan="2"/>

            <Button x:Name="btnAccount" Content="Личный кабинет"
                    Style="{StaticResource BottomButtonStyle}"
                    Grid.Column="4" Margin="5,0,4,0" Click="btnAccount_Click"/>

            <Button x:Name="btnSupport" Content="Служба поддержки"
                    Style="{StaticResource BottomButtonStyle}"
                    Grid.Column="5" Margin="6,0,5,0" Click="btnSupport_Click"/>
        </Grid>

        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" x:Name="SideMenuColumn"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#f5f5f5" x:Name="SideMenu">
                <StackPanel>
                    <Button x:Name="btnToggleMenu" Content="≡" 
                            FontSize="20" Width="48" Height="46" 
                            Margin="5" HorizontalAlignment="Left"
                            Click="btnToggleMenu_Click"/>

                    <TextBlock x:Name="CourseTitle" FontSize="18" FontWeight="Bold" 
                               Margin="10,20,10,10" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CourseDescription" FontSize="14"
                               Margin="10,0,10,20" TextWrapping="Wrap"/>
                    <Button x:Name="btnCompleteCourse" Content="Завершить курс" Click="btnCompleteCourse_Click" Margin="5"/>
                    <StackPanel x:Name="MenuItemsPanel" Margin="10,20,10,10">


                    </StackPanel>
                    <Button x:Name="btnExit" Content="Выйти"
                Style="{StaticResource BottomButtonStyle}" Height="NaN"
                Click="btnMain_Click" MinWidth="100"/>
                    <TextBlock x:Name="AvailableUntilLabel" 
                FontSize="12" 
                Margin="10,10,10,0"
                TextWrapping="Wrap"
                Foreground="Gray"/>
                </StackPanel>

            </Border>


            <Grid x:Name="ContentGrid" Grid.Column="1">

            </Grid>

        </Grid>

    </Grid>
</Window>