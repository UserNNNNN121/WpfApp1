<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="av" 
    x:Class="WpfApp1.Main"
    Title="Enterprise Courses" 
    Height="1040" 
    Width="1980" 
    ResizeMode="CanResizeWithGrip" Icon="/logo2.png">

    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="#3366CC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="DarkBlue"/>
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BottomButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" 
                                            RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="DarkGray"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="Gray"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="LightGray"/>
                                <Setter Property="Foreground" Value="DarkGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CarouselButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style x:Key="CourseCardStyle" TargetType="Button">
            <Setter Property="Width" Value="280"/>
            <Setter Property="Height" Value="180"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                    VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="458*"/>
                <ColumnDefinition Width="375*"/>
                <ColumnDefinition Width="83*"/>
                <ColumnDefinition Width="458*"/>
                <ColumnDefinition Width="458*"/>
            </Grid.ColumnDefinitions>

            <Image Source="/logo.png"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Height="51"
                   Width="76"
                   Grid.Column="0"
                   Margin="14,4,0,0"
                   Cursor="Hand"
                   MouseLeftButtonDown="btnMain_Click"/>

            <Button x:Name="btnFAQs" Content="FAQs"
                    Style="{StaticResource BottomButtonStyle}"
                    Grid.Column="1" Margin="5,0,6,0" Click="btnFAQs_Click"/>

            <Button x:Name="btnMain" Content="Главная"
                    Style="{StaticResource BottomButtonStyle}"
                    Grid.Column="2" Margin="4,0,5,0" Click="btnMain_Click" Grid.ColumnSpan="2"/>

            <Button x:Name="btnAccount" Content="Личный кабинет"
                    Style="{StaticResource BottomButtonStyle}"
                    Grid.Column="4" Margin="5,0,4,0" Click="btnAccount_Click"/>

            <Button x:Name="btnSupport" Content="Служба поддержки"
                    Style="{StaticResource BottomButtonStyle}"
                    Grid.Column="5" Margin="6,0,5,0" Click="btnSupport_Click"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Margin="0,40,0,0">
                    <TextBlock Text="Курсы для начинающих:" 
                       FontSize="28" 
                       Margin="40,0,40,20"
                       FontWeight="SemiBold"/>

                    <Grid Margin="40,0,40,40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnBeginnerPrev" Grid.Column="0" Style="{StaticResource CarouselButtonStyle}">
                            <Image Source="/left-arrow.png" Stretch="Uniform"/>
                        </Button>

                        <ScrollViewer x:Name="beginnerCoursesScroll" Grid.Column="1"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="beginnerCoursesItems" Orientation="Horizontal"/>
                        </ScrollViewer>

                        <Button x:Name="btnBeginnerNext" Grid.Column="2" Style="{StaticResource CarouselButtonStyle}">
                            <Image Source="/right-arrow.png" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,40,0,40" >
                    <TextBlock Text="Курсы для специалистов:" 
                       FontSize="28" 
                       Margin="40,0,40,20"
                       FontWeight="SemiBold"/>

                    <Grid Margin="40,0,40,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnSpecialistPrev" Grid.Column="0" Style="{StaticResource CarouselButtonStyle}">
                            <Image Source="/left-arrow.png" Stretch="Uniform"/>
                        </Button>

                        <ScrollViewer x:Name="specialistCoursesScroll" Grid.Column="1"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="specialistCoursesItems" Orientation="Horizontal"/>
                        </ScrollViewer>

                        <Button x:Name="btnSpecialistNext" Grid.Column="2" Style="{StaticResource CarouselButtonStyle}">
                            <Image Source="/right-arrow.png" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Button x:Name="btnExit" Content="Выйти" 
                Style="{StaticResource BottomButtonStyle}"
                Grid.Row="1" Margin="0,913,15,10" Height="NaN" 
                Click="btnExit_Click" HorizontalAlignment="Right" MinWidth="100" VerticalAlignment="Stretch"/>
    </Grid>
</Window>