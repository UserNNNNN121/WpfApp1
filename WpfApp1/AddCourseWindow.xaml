
<Window x:Class="WpfApp1.AddCourseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление нового курса" WindowStartupLocation="CenterOwner"
        Width="800" Height="600" Icon="/logo2.png">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="step1Panel" Grid.Row="1">
            <Label Content="Название:" FontSize="16" Margin="0,0,0,5"/>
            <TextBox x:Name="txtName" FontSize="16" Margin="0,0,0,10"/>

            <Label Content="Описание:" FontSize="16" Margin="0,0,0,5"/>
            <TextBox x:Name="txtDescription" Height="60" TextWrapping="Wrap" 
         VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Width="780"/>


            <Label Content="Специальность:" FontSize="16" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbSpeciality" FontSize="16" Margin="0,0,0,10"/>

            <Label Content="Доступность:" FontSize="16" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbAvailability" FontSize="16" Margin="0,0,0,10"/>

            <Label Content="Партнер:" FontSize="16" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbPartner" FontSize="16" Margin="0,0,0,10"/>

            <Label Content="Доступен до:" FontSize="16" Margin="0,0,0,5"/>
            <DatePicker x:Name="dpAvailableUntil" FontSize="16" Margin="0,0,0,10"/>

            <Button Content="Настройки сертификата" Margin="0,10,0,0" Click="BtnCertificateSettings_Click"/>
        </StackPanel>

        <Grid x:Name="step2Panel" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <Label Content="Информация о курсе:" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="txtPreviewName" FontSize="14" Margin="10,0,0,5"/>
                <TextBlock x:Name="txtPreviewDescription" FontSize="14" Margin="10,0,0,5" TextWrapping="Wrap"/>
                <TextBlock x:Name="txtPreviewSpeciality" FontSize="14" Margin="10,0,0,5"/>
                <TextBlock x:Name="txtPreviewAvailability" FontSize="14" Margin="10,0,0,5"/>
                <TextBlock x:Name="txtPreviewPartner" FontSize="14" Margin="10,0,0,5"/>
                <TextBlock x:Name="txtPreviewAvailableUntil" FontSize="14" Margin="10,0,0,5"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <Label Content="Модули курса:" FontSize="16" FontWeight="Bold"/>
                <ListBox x:Name="lstModules" Height="200" Margin="0,5,0,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Description}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnAddModule" Content="Добавить модуль" Width="120" Margin="5" Click="btnAddModule_Click"/>
                    <Button x:Name="btnEditModule" Content="Редактировать" Width="120" Margin="5" Click="btnEditModule_Click"/>
                    <Button x:Name="btnDeleteModule" Content="Удалить" Width="120" Margin="5" Click="btnDeleteModule_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnBack" Content="Назад" Width="100" Margin="5" Click="btnBack_Click"/>
            <Button x:Name="btnNext" Content="Далее" Width="100" Margin="5" Click="btnNext_Click"/>
        </StackPanel>
    </Grid>
</Window>