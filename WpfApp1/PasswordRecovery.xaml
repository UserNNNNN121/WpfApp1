<Window x:Class="WpfApp1.PasswordRecovery"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Enterprice Courses" Height="1040" Width="1980" ResizeMode="CanResizeWithGrip" Icon="/logo2.png">

    <Window.Resources>
        <Style x:Key="BottomButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="DarkGray"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="Gray"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="LightGray"/>
                                <Setter Property="Foreground" Value="DarkGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Panel.ZIndex="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Source="/logo.png"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Height="51"
               Width="76"
               Grid.Column="0"
               Margin="14,0,0,0"
               Cursor="Hand"
               MouseLeftButtonDown="btnMain_Click"/>
                <UniformGrid Grid.Column="1" Rows="1">
                    <Button x:Name="btnFAQs" Content="FAQs"
        Style="{StaticResource BottomButtonStyle}"
 Margin="2,5" Click="btnFAQs_Click"/>

                    <Button x:Name="btnMain" Content="Главная"
        Style="{StaticResource BottomButtonStyle}"
 Margin="2,5" Click="btnMain_Click"/>

                    <Button x:Name="btnAccount" Content="Личный кабинет"
        Style="{StaticResource BottomButtonStyle}"
 Margin="2,5" Click="btnAccount_Click"/>

                    <Button x:Name="btnSupport" Content="Служба поддержки"
        Style="{StaticResource BottomButtonStyle}"
 Margin="2,5" Click="btnSupport_Click"/>

                    <Button x:Name="btnAdmin" Content="Кабинет администратора"
        Style="{StaticResource BottomButtonStyle}"
Margin="2,5" Click="btnAdmin_Click"
        Visibility="Collapsed"/>
                </UniformGrid>
            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,150,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Content="Восстановление пароля" FontSize="36" HorizontalAlignment="Center" Height="95" Grid.Row="0"/>

                <UniformGrid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" Columns="1">
                    <Label Content="Эл. почта или логин" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBox x:Name="boxLog" Width="450" Height="35" HorizontalAlignment="Center"/>
                    <Button x:Name="btnSendCode" Content="Отправить код" FontSize="22" Height="52" Click="btnSendCode_Click"/>
                    <TextBox x:Name="boxCode" Width="450" Height="35" HorizontalAlignment="Center"/>
                    <Button x:Name="btnRecover" Content="Восстановить" FontSize="22" Click="btnRestore_Click"/>
                </UniformGrid>
                <Label Content="Если не удается восстановить доступ, обратитесь к Администратору или в Службу поддержки" FontSize="22" HorizontalAlignment="Center" Margin="0,315,0,301" Grid.Row="1" Foreground="#FF690707"/>
            </Grid>
        </ScrollViewer>

        <Button x:Name="btnExit" Content="Выйти" 
                Style="{StaticResource BottomButtonStyle}"
                Grid.Row="1" Margin="0,913,15,10" Height="NaN" 
                Click="btnExit_Click" HorizontalAlignment="Right" MinWidth="100" VerticalAlignment="Stretch"/>
    </Grid>
</Window>