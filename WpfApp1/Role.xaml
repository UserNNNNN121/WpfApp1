<Window x:Class="WpfApp1.Role"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enterprice Courses" Height="1040" Width="1980" ResizeMode="CanResizeWithGrip" Icon="/logo2.png">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="#3366CC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="DarkBlue"/>
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BottomButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" 
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="DarkGray"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="Gray"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="LightGray"/>
                                <Setter Property="Foreground" Value="DarkGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Source="/logo.png"
           HorizontalAlignment="Left"
           VerticalAlignment="Top"
           Height="51"
           Width="76"
           Grid.Column="0"
           Margin="14,4,0,0"
           Cursor="Hand"
           MouseLeftButtonDown="btnMain_Click"/>

                <Button x:Name="btnFAQs" Content="FAQs"
     Style="{StaticResource BottomButtonStyle}"
     Grid.Column="1" Margin="5"/>

                <Button x:Name="btnMain" Content="Главная"
     Style="{StaticResource BottomButtonStyle}"
     Grid.Column="2" Margin="5" Click="btnMain_Click"/>

                <Button x:Name="btnAccount" Content="Личный кабинет"
     Style="{StaticResource BottomButtonStyle}"
     Grid.Column="3" Margin="5" Click="btnAccount_Click"/>

                <Button x:Name="btnSupport" Content="Служба поддержки"
     Style="{StaticResource BottomButtonStyle}"
     Grid.Column="4" Margin="5"/>
            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid Background="Transparent"/>
                <StackPanel>
                    <Label Content="Выберите группу:" 
                           HorizontalAlignment="Center" 
                           Margin="0,150,0,60" 
                           FontSize="36"/>
                    <UniformGrid Columns="3" VerticalAlignment="Stretch">
                        <Button x:Name="btnEngineer" MinWidth="130" MinHeight="139" Margin="10">
                            <Grid Width="130" Height="190">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="40"/>
                                </Grid.RowDefinitions>
                                <Image Grid.Row="0" Source="/engineeravatar.png" 
                   Height="138" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Stretch="Uniform" />
                                <TextBlock Grid.Row="1" Text="Инженер" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                            </Grid>
                        </Button>
                        <Button x:Name="btnTechologist" MinWidth="130" MinHeight="139" Margin="10">
                            <Grid Width="130" Height="190">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="40"/>
                                </Grid.RowDefinitions>
                                <Image Grid.Row="0" Source="/technologistavatar.png" 
                   Height="138" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Stretch="Uniform" />
                                <TextBlock Grid.Row="1" Text="Технолог" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                            </Grid>
                        </Button>
                        <Button x:Name="btnLawyer" MinWidth="130" MinHeight="139" Margin="10">
                            <Grid Width="132" Height="190">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="40"/>
                                </Grid.RowDefinitions>
                                <Image Grid.Row="0" Source="/lawyeravatar.png" 
                   Height="140" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Stretch="Uniform" />
                                <TextBlock Grid.Row="1" Text="Юрист" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                            </Grid>
                        </Button>
                        <Button x:Name="btnFinancist" MinWidth="130" MinHeight="139" Margin="10">
                            <Grid Width="130" Height="190">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="40"/>
                                </Grid.RowDefinitions>
                                <Image Grid.Row="0" Source="/financeavatar.png" 
                   Height="137" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Stretch="Uniform" />
                                <TextBlock Grid.Row="1" Text="Финансист" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                            </Grid>
                        </Button>
                        <Button x:Name="btnITspec" MinWidth="130" MinHeight="139" Margin="10">
                            <Grid Width="130" Height="190">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="40"/>
                                </Grid.RowDefinitions>
                                <Image Grid.Row="0" Source="/itavatar.png" 
                   Height="126" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Stretch="Uniform" />
                                <TextBlock Grid.Row="1" Text="IT" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                            </Grid>
                        </Button>
                        <Button x:Name="btnAccountist" MinWidth="130" MinHeight="139" Margin="10">
                            <Grid Width="130" Height="190">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="40"/>
                                </Grid.RowDefinitions>
                                <Image Grid.Row="0" Source="/accountantavatar.png" 
                   Height="123" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Stretch="Uniform" />
                                <TextBlock Grid.Row="1" Text="Бухгалтер" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                            </Grid>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Button x:Name="btnBack" Content="Назад" 
                Style="{StaticResource BottomButtonStyle}"
                Grid.Row="2" Margin="0,0,15,10" Height="36" 
                Click="btnBack_Click" HorizontalAlignment="Right" MinWidth="100"/>
    </Grid>
</Window>