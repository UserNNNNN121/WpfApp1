<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Enterprice Courses" Height="1040" Width="1980" ResizeMode="CanResizeWithGrip"
        WindowState="Maximized" Icon="/logo2.png">
    <Window.Resources>

        <Style x:Key="BottomButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="DarkGray"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="Gray"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="LightGray"/>
                                <Setter Property="Foreground" Value="DarkGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="23*"/>
            <ColumnDefinition Width="373*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="2">

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Source="/logo.png"
           HorizontalAlignment="Left"
           VerticalAlignment="Top"
           Height="51"
           Width="76"
           Grid.Column="0"
           Margin="14,4,0,0"
           Cursor="Hand"
           MouseLeftButtonDown="btnMain_Click"/>

                <Button x:Name="btnFAQs" Content="FAQs"
     Style="{StaticResource BottomButtonStyle}"
     Grid.Column="1" Margin="5" Click="btnFAQs_Click"/>

                <Button x:Name="btnMain" Content="Главная"
     Style="{StaticResource BottomButtonStyle}"
     Grid.Column="2" Margin="5" Click="btnMain_Click"/>

                <Button x:Name="btnAccount" Content="Личный кабинет"
     Style="{StaticResource BottomButtonStyle}"
     Grid.Column="3" Margin="5" Click="btnAccount_Click"/>

                <Button x:Name="btnSupport" Content="Служба поддержки"
     Style="{StaticResource BottomButtonStyle}"
     Grid.Column="4" Margin="5" Click="btnSupport_Click"/>

            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="2" Margin="0,0,0,-50">
            <Grid Height="958">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="189*"/>
                    <ColumnDefinition Width="23*"/>
                    <ColumnDefinition Width="188*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Авторизация" FontSize="36" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="1" Margin="148,165,0,725"/>
                <Label Content="Эл. почта или логин" HorizontalAlignment="Center" Margin="0,290,0,0" VerticalAlignment="Top" Grid.Column="1" Height="43" Width="211" FontSize="22"/>
                <TextBox x:Name="boxLogin" HorizontalAlignment="Center" Margin="0,338,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="516" Height="45" Grid.Column="1"/>
                <Label Content="Пароль" HorizontalAlignment="Left" Margin="213,400,0,0" VerticalAlignment="Top" Grid.Column="1" Height="43" Width="104" FontSize="22"/>
                <PasswordBox x:Name="passwBox" Margin="0,448,0,0" VerticalAlignment="Top" Height="45" Grid.Column="1" Width="516"/>
                <TextBox x:Name="boxPassword" Margin="0,448,0,0" VerticalAlignment="Top" Height="45" Grid.Column="1" Width="516" Visibility="Collapsed"/>
                <Button x:Name="btnTogglePassword" HorizontalAlignment="Right" VerticalAlignment="Top" Width="45" Height="45" Grid.Column="1" Margin="0,448,0,0" Click="btnTogglePassword_Click">
                    <Image x:Name="imgPasswordIcon" Width="20" Height="20" Source="/hideeye.png" />
                </Button>

                <Button x:Name="btnSignUp" Content="Войти" Margin="0,518,0,0" HorizontalAlignment="Center" Width="516" Grid.Column="1" FontSize="22" Height="63" VerticalAlignment="Top" Click="btnSignUp_Click"/>
                <Button x:Name="btnAccessRecovery" Content="Восстановить доступ" Margin="127,581,0,0" HorizontalAlignment="Left" Width="268" Grid.Column="1" FontSize="22" Height="45" VerticalAlignment="Top" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="#FF335BFF" Click="btnAccessRecovery_Click"/>
                <Button x:Name="btnReg" Content="Зарегистрироваться" HorizontalAlignment="Center" Margin="0,663,0,0" VerticalAlignment="Top" Height="63" Width="516" Grid.Column="1" Click="btnReg_Click" FontSize="22"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>