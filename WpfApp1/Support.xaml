<Window x:Class="WpfApp1.Support"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Enterprice Courses" Height="1040" Width="1980" ResizeMode="CanResizeWithGrip" Icon="/logo2.png">

    <Window.Resources>
        <Style x:Key="BottomButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="DarkGray"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="Gray"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="LightGray"/>
                                <Setter Property="Foreground" Value="DarkGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Panel.ZIndex="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Source="/logo.png"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Height="51"
               Width="76"
               Grid.Column="0"
               Margin="14,0,0,0"
               Cursor="Hand"
               MouseLeftButtonDown="btnMain_Click"/>
                <UniformGrid Grid.Column="1" Rows="1">
                    <Button x:Name="btnFAQs" Content="FAQs"
                            Style="{StaticResource BottomButtonStyle}"
                            Margin="2,5" Click="btnFAQs_Click"/>
                    <Button x:Name="btnMain" Content="Главная"
                            Style="{StaticResource BottomButtonStyle}"
                            Margin="2,5" Click="btnMain_Click"/>
                    <Button x:Name="btnAccount" Content="Личный кабинет"
                            Style="{StaticResource BottomButtonStyle}"
                            Margin="2,5" Click="btnAccount_Click"/>
                    <Button x:Name="btnSupport" Content="Служба поддержки"
                            Style="{StaticResource BottomButtonStyle}"
                            Margin="2,5" Click="btnSupport_Click"/>
                    <Button x:Name="btnAdmin" Content="Кабинет администратора"
                            Style="{StaticResource BottomButtonStyle}"
                            Margin="2,5" Click="btnAdmin_Click"
                            Visibility="Collapsed"/>
                </UniformGrid>
            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20" HorizontalAlignment="Center">
                <Label Content="Служба поддержки" 
                       FontSize="36" 
                       HorizontalAlignment="Center" 
                       Margin="0,20,0,30"/>

                <Label Content="Обращение:" 
                       FontSize="28" 
                       Margin="0,0,0,10" Width="165"/>
                <TextBox x:Name="txtBoxAppeal" 
                         FontSize="22" 
                         TextWrapping="Wrap" 
                         Height="182" 
                         Width="1014"
                         Margin="0,0,0,30"/>

                <Label Content="Прикрепить файлы (jpg, png, docx, pdf, txt, до 5 файлов):" 
                       FontSize="20" 
                       Margin="0,0,0,10" Width="530"/>
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            Margin="0,0,0,20">
                    <Button x:Name="btnAttach" 
                            Content="Выбрать файлы" 
                            FontSize="20" 
                            Margin="0,0,10,0"/>
                    <Button x:Name="btnRemoveAllAttachments" 
                            Content="Удалить все" 
                            FontSize="20" 
                            Width="100" 
                            Visibility="Collapsed"/>
                </StackPanel>

                <ItemsControl x:Name="attachmentsContainer" 
                             HorizontalAlignment="Center" 
                             Margin="0,0,0,30" 
                             Width="800" 
                             Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Width="800"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="LightGray" 
                                    BorderThickness="1" 
                                    CornerRadius="5" 
                                    Margin="5" 
                                    Padding="5" 
                                    Background="#F5F5F5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CompactName}" 
                                               VerticalAlignment="Center"
                                               FontSize="12" 
                                               Margin="0,0,5,0"/>
                                    <Button Content="×" 
                                            Width="20" 
                                            Height="20" 
                                            FontWeight="Bold" 
                                            Padding="0"
                                            Click="BtnRemoveSingleAttachment_Click" 
                                            Tag="{Binding}"
                                            Background="Transparent" 
                                            BorderThickness="0"
                                            Foreground="Red"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Vertical" 
                            HorizontalAlignment="Center" 
                            Margin="0,0,0,20">
                    <Label Content="Введите email для обратной связи (по желанию):" 
                           FontSize="20" 
                           Margin="0,0,0,10"/>
                    <TextBox x:Name="txtEmail" 
                             FontSize="20" 
                             Width="400" 
                             MinWidth="200"
                             Margin="0,0,0,10"/>
                    <CheckBox x:Name="chkAutoEmail" 
                              Content="Использовать мой email" 
                              FontSize="20" 
                              HorizontalAlignment="Center" 
                              Visibility="Collapsed"
                              Margin="0,10,0,0"/>
                </StackPanel>

                <Label Content="Все обращения анонимны" 
                       FontSize="20" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,30"/>

                <Button x:Name="btnSend" 
                        Content="Отправить" 
                        FontSize="36" 
                        Width="300"
                        Height="68"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>

        <Button x:Name="btnExit" 
                Content="Выйти" 
                Style="{StaticResource BottomButtonStyle}"
                Grid.Row="2" 
                Margin="0,0,15,10" 
                Height="40"
                Click="btnExit_Click" 
                HorizontalAlignment="Right" 
                MinWidth="100"/>
    </Grid>
</Window>