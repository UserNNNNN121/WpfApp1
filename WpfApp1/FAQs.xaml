<Window x:Class="WpfApp1.FAQs"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Enterprice Courses" Height="1040" Width="1980" ResizeMode="CanResizeWithGrip" Icon="/logo2.png">

    <Window.Resources>
        <Style x:Key="BottomButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="DarkGray"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="Gray"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="LightGray"/>
                                <Setter Property="Foreground" Value="DarkGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FAQItemStyle" TargetType="Grid">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Background" Value="#FFF5F5F5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="QuestionTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="AnswerTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Margin" Value="10,5,10,15"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SupportButtonStyle" TargetType="Button" BasedOn="{StaticResource BottomButtonStyle}">
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Panel.ZIndex="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Source="/logo.png"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Height="51"
               Width="76"
               Grid.Column="0"
               Margin="14,0,0,0"
               Cursor="Hand"
               MouseLeftButtonDown="btnMain_Click"/>
                <UniformGrid Grid.Column="1" Rows="1">
                    <Button x:Name="btnFAQs" Content="FAQs"
        Style="{StaticResource BottomButtonStyle}"
 Margin="2,5" Click="btnFAQs_Click"/>

                    <Button x:Name="btnMain" Content="Главная"
        Style="{StaticResource BottomButtonStyle}"
 Margin="2,5" Click="btnMain_Click"/>

                    <Button x:Name="btnAccount" Content="Личный кабинет"
        Style="{StaticResource BottomButtonStyle}"
 Margin="2,5" Click="btnAccount_Click"/>

                    <Button x:Name="btnSupport" Content="Служба поддержки"
        Style="{StaticResource BottomButtonStyle}"
 Margin="2,5" Click="btnSupport_Click"/>

                    <Button x:Name="btnAdmin" Content="Кабинет администратора"
        Style="{StaticResource BottomButtonStyle}"
Margin="2,5" Click="btnAdmin_Click"
        Visibility="Collapsed"/>
                </UniformGrid>
            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Grid.Row="1" Margin="20">
                <Label Content="Частые вопросы:" 
           FontSize="36" 
           Margin="0,0,0,10"/>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FAQPanel"/>
                </ScrollViewer>
                <StackPanel x:Name="notFoundPanel">
                <Label Content="Не нашли ответа на интересующий вопрос?" 
                       FontSize="28" 
                       Margin="0,40,0,10"
                       HorizontalAlignment="Center"/>

                <Button Content="Обратиться в службу поддержки" 
                        Style="{StaticResource SupportButtonStyle}"
                        HorizontalAlignment="Center"
                        Click="btnSupport_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Button x:Name="btnExit" Content="Выйти" Grid.RowSpan="3"
                Style="{StaticResource BottomButtonStyle}"
                Grid.Row="1" Margin="0,913,15,10" Height="NaN"
                Click="btnExit_Click" HorizontalAlignment="Right" MinWidth="100" VerticalAlignment="Stretch"/>
    </Grid>
</Window>