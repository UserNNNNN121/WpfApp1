<Window x:Class="WpfApp1.AdminControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Enterprice Courses" Height="1040" Width="1980" ResizeMode="CanResizeWithGrip"
        WindowState="Maximized" Icon="/logo2.png">
    <Window.Resources>
        <Style TargetType="Expander">
            <Setter Property="Background" Value="WhiteSmoke"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="18" FontWeight="Bold"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BottomButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="DarkGray"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="Gray"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="LightGray"/>
                                <Setter Property="Foreground" Value="DarkGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Source="/logo.png"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Height="51"
                       Width="76"
                       Grid.Column="0"
                       Margin="14,4,0,0"
                       Cursor="Hand"
                       MouseLeftButtonDown="btnMain_Click"/>

                <Button x:Name="btnFAQs" Content="FAQs"
                         Style="{StaticResource BottomButtonStyle}"
                         Grid.Column="1" Margin="5" Click="btnFAQs_Click"/>

                <Button x:Name="btnAccount" Content="Личный кабинет"
                         Style="{StaticResource BottomButtonStyle}"
                         Grid.Column="2" Margin="5" Click="btnAccount_Click"/>

                <Button x:Name="btnAdmin" Content="Кабинет администратора" 
                 Style="{StaticResource BottomButtonStyle}" 
                  Grid.Column="5" Margin="6,0,5,0" Click="btnAdmin_Click"/>
            </Grid>
        </Grid>
        <ScrollViewer x:Name="mainScrollViewer" Grid.Row="1" 
              HorizontalScrollBarVisibility="Disabled" 
              VerticalScrollBarVisibility="Auto">
            <Grid x:Name="mainContentGrid" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Content="Кабинет Администратора" FontSize="36" 
               HorizontalAlignment="Center" Grid.Row="0"/>

                <UniformGrid Grid.Row="1" Columns="1" HorizontalAlignment="Center" 
                    VerticalAlignment="Top" Margin="0,100,0,0" Width="785">
                    <Button x:Name="btnUsers" Content="Управление пользователями" 
                    FontSize="22" Height="61" Click="btnUsers_Click"
                    Margin="0,0,0,30"/>
                    <Button x:Name="btnCourses" Content="Управление курсами" 
                    FontSize="22" Height="61" Click="btnCourses_Click"
                    Margin="0,0,0,20"/>
                    <Button x:Name="btnProcessing" Content="Обработка обращений" 
                    FontSize="22" Height="61" Click="btnProcessing_Click"/>
                </UniformGrid>
            </Grid>
        </ScrollViewer>
        
        <Button x:Name="btnExit" Content="Выйти" 
        Style="{StaticResource BottomButtonStyle}"
        Grid.Row="2" Margin="0,0,15,10" Height="36" 
        Click="btnExit_Click" HorizontalAlignment="Right" MinWidth="100"/>
        <Button x:Name="btnBack" Content="Назад" 
                Style="{StaticResource BottomButtonStyle}"
                Grid.Row="2" Margin="0,0,15,10" Height="36" 
                Click="btnBack_Click" HorizontalAlignment="Left" MinWidth="100"
                Visibility="Collapsed"/>
    </Grid>
</Window>