<Window x:Class="WpfApp1.Registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Enterprice Courses" Height="1040" Width="1980" ResizeMode="CanResizeWithGrip" Icon="/logo2.png">

    <Window.Resources>
        <Style x:Key="BottomButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="DarkGray"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="Gray"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="LightGray"/>
                                <Setter Property="Foreground" Value="DarkGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Source="/logo.png"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Height="51"
                   Width="76"
                   Grid.Column="0"
                   Margin="14,4,0,0"
                   Cursor="Hand"
                   MouseLeftButtonDown="btnMain_Click"/>

                <Button x:Name="btnFAQs" Content="FAQs"
             Style="{StaticResource BottomButtonStyle}"
             Grid.Column="1" Margin="5" Click="btnFAQs_Click"/>

                <Button x:Name="btnMain" Content="Главная"
             Style="{StaticResource BottomButtonStyle}"
             Grid.Column="2" Margin="5" Click="btnMain_Click"/>

                <Button x:Name="btnAccount" Content="Личный кабинет"
             Style="{StaticResource BottomButtonStyle}"
             Grid.Column="3" Margin="5" Click="btnAccount_Click"/>

                <Button x:Name="btnSupport" Content="Служба поддержки"
             Style="{StaticResource BottomButtonStyle}"
             Grid.Column="4" Margin="5"  Click="btnSupport_Click"/>
            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Content="Регистрация" FontSize="36" HorizontalAlignment="Center" Height="95" Grid.Row="0"/>

                <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="20,20,0,20">
                        <Label Content="Логин" FontSize="22" HorizontalAlignment="Center"/>
                        <TextBox x:Name="boxLog" Width="350" Height="28" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <Label Content="ФИО (Пожалуйста, укажите реальное ФИО)" FontSize="22" HorizontalAlignment="Center"/>
                        <TextBox x:Name="boxName" Width="350" Height="28" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <Label Content="Пароль" FontSize="22" HorizontalAlignment="Center"/>
                        <PasswordBox x:Name="boxPassw" Width="350" Height="28" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <Label Content="Повторите пароль" FontSize="22" HorizontalAlignment="Center"/>
                        <PasswordBox x:Name="boxReppassw" Width="350" Height="28" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="20" Width="400">
                        <Label Content="Электронная почта" FontSize="22" HorizontalAlignment="Center"/>
                        <TextBox x:Name="boxEmail" Width="350" Height="28" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <Button x:Name="btnSendCode" Content="Отправить код подтверждения" 
            FontSize="18" Width="350" Height="40" Margin="0,0,0,20"
            Click="btnSendCode_Click"/>

                        <Label Content="Код подтверждения" FontSize="22" HorizontalAlignment="Center"/>
                        <TextBox x:Name="boxVerificationCode" Width="350" Height="28" HorizontalAlignment="Center" Margin="0,0,0,50"/>
                        <Button x:Name="btnAccept" Content="Подтвердить регистрацию" 
            FontSize="18" Width="350" Height="69"
            Click="btnAccept_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Button x:Name="btnBack" Content="Назад" 
                Style="{StaticResource BottomButtonStyle}"
                Grid.Row="2" Margin="0,0,15,10" Height="36" 
                Click="btnBack_Click" HorizontalAlignment="Right" MinWidth="100"/>
    </Grid>
</Window>